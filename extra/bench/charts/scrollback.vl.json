{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Cost of a full scrollback",
    "subtitle": "median output latency (ms) and memory (PSS, MiB) with a full scrollback; lines on a log scale, each terminal on its own scale"
  },
  "data": {
    "url": "scrollback.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lines": "number",
        "latency_ms": "number",
        "pss_mib": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(datum.terminal, 'raterm') == 0 ? 'raterm' : 'others'",
      "as": "who"
    }
  ],
  "vconcat": [
    {
      "facet": {
        "column": {
          "field": "terminal",
          "type": "nominal",
          "sort": [
            "raterm",
            "gnome-terminal",
            "terminator",
            "alacritty",
            "kitty",
            "foot"
          ],
          "title": null
        }
      },
      "spacing": 8,
      "spec": {
        "width": 120,
        "height": 120,
        "mark": {
          "type": "line",
          "point": true
        },
        "encoding": {
          "x": {
            "field": "lines",
            "type": "quantitative",
            "scale": {
              "type": "log"
            },
            "title": "lines",
            "axis": {
              "values": [
                10000,
                100000,
                1000000
              ],
              "format": "~s"
            }
          },
          "y": {
            "field": "latency_ms",
            "type": "quantitative",
            "title": "latency (ms)",
            "scale": {
              "zero": true
            }
          },
          "color": {
            "field": "who",
            "type": "nominal",
            "sort": [
              "raterm",
              "others"
            ],
            "title": null,
            "legend": null
          }
        }
      },
      "resolve": {
        "scale": {
          "y": "independent"
        }
      }
    },
    {
      "facet": {
        "column": {
          "field": "terminal",
          "type": "nominal",
          "sort": [
            "raterm",
            "gnome-terminal",
            "terminator",
            "alacritty",
            "kitty",
            "foot"
          ],
          "title": null
        }
      },
      "spacing": 8,
      "spec": {
        "width": 120,
        "height": 120,
        "mark": {
          "type": "line",
          "point": true
        },
        "encoding": {
          "x": {
            "field": "lines",
            "type": "quantitative",
            "scale": {
              "type": "log"
            },
            "title": "lines",
            "axis": {
              "values": [
                10000,
                100000,
                1000000
              ],
              "format": "~s"
            }
          },
          "y": {
            "field": "pss_mib",
            "type": "quantitative",
            "title": "PSS (MiB)",
            "scale": {
              "zero": true
            }
          },
          "color": {
            "field": "who",
            "type": "nominal",
            "sort": [
              "raterm",
              "others"
            ],
            "title": null,
            "legend": null
          }
        }
      },
      "resolve": {
        "scale": {
          "y": "independent"
        }
      }
    }
  ]
}
