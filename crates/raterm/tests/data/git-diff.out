index 0000000..626ba45
--- /dev/null
+++ b/crates/rt/assets/style.css
@@ -0,0 +1,18 @@
+:root {
+  --fg: #d8dee9;
+  --bg: #1e1e24;
+}
+
+body {
+  margin: 0;
+  padding: 4px;
+  background: var(--bg);
+  color: var(--fg);
+}
+
+#out {
+  margin: 0;
+  font-family: monospace;
+  white-space: pre-wrap;
+  word-break: break-all;
+}


